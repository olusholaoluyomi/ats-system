rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // users can only read/write their own scan history
    match /users/{userId}/scans/{scanId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // any authenticated user can create a scan log entry (write-only, no reads from client)
    match /scan_logs/{logId} {
      allow create: if request.auth != null;
    }

    // aggregate landing-page counters (Users Served, Resumes Analyzed) live in
    // their own insights/global doc, separate from user scan records, so they
    // keep growing even when a user clears their history. readable by anyone
    // (the hero renders before a visitor has signed in), writable only by
    // authenticated users: each counter increments via increment(1).
    match /insights/global {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
