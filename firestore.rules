rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // users can only read/write their own scan history
    match /users/{userId}/scans/{scanId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // any authenticated user can create a scan log entry (write-only, no reads from client)
    match /scan_logs/{logId} {
      allow create: if request.auth != null;
    }

    // the landing page's live "Users Served" counter is read by anyone (the
    // hero renders before a visitor has signed in), but only written by
    // authenticated users: the counter increments once per new signup.
    match /stats/public {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
