rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // users can only read/write their own scan history
    match /users/{userId}/scans/{scanId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // users can only read/write their own tracked applications
    match /users/{userId}/applications/{applicationId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // users can only read/write their own profile (display name, avatar,
    // job-board search + notification preferences). single fixed 'settings'
    // doc, same trust level as their own scans/applications - it's the
    // user's own data, not curated/admin content.
    match /users/{userId}/profile/{profileDoc} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // per-account review entitlements (free-review-used flag + paid credits).
    // written ONLY by the admin SDK via the billing transactions on the server
    // (/api/analyze gate, /api/payment/*); clients may read their own doc so
    // the scanner can show the paywall, but never mutate it (or they could
    // grant themselves unlimited free reviews). the doc is the fixed 'state'
    // subdocument of the per-user billing collection.
    match /users/{userId}/billing/{billingDoc} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // server-writable only for billing operations
      allow write: if false;
    }

    // ledger of initiated/settled Paystack checkouts. written only by the server
    // (initialize/webhook/verify routes). clients may read their own payments
    // for payment history display, but never write (to prevent forgery).
    match /payments/{paymentId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // any authenticated user can create a scan log entry (write-only, no reads from client)
    match /scan_logs/{logId} {
      allow create: if request.auth != null;
    }

    // aggregate landing-page counters (Users Served, Resumes Analyzed) live in
    // their own insights/global doc, separate from user scan records, so they
    // keep growing even when a user clears their history. readable by anyone
    // (the hero renders before a visitor has signed in), writable only by
    // authenticated users: each counter increments via increment(1).
    match /insights/global {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // job board postings: public read (browsable before signup, unlike scan
    // history), written only by the ingestion script via the admin SDK
    // (which bypasses rules entirely) - never by any client. mirrors
    // billing/payments' write:false precedent.
    match /jobs/{jobId} {
      allow read: if true;
      allow write: if false;
    }

    // apply-click counters, one doc per job. public write (not just
    // authenticated, unlike insights/global) because the job board itself
    // has no auth gate - an anonymous visitor can click Apply without ever
    // signing in. low-stakes counter, same reasoning as insights/global for
    // why an inflated count is not a meaningful attack surface. read is
    // admin-only in practice (no UI reads this directly - see
    // /api/admin/job-analytics) but left public to match every other
    // low-stakes counter in this file rather than adding a one-off
    // asymmetric rule.
    match /job_analytics/{jobId} {
      allow read: if true;
      allow write: if true;
    }

    // admin-curated job-board companies, added via the token-gated
    // /api/admin/companies routes (see $lib/server/admin-auth) rather than
    // PR review like seed-companies.ts/discovered-companies.json - but
    // still never client-writable directly. mirrors jobs/{jobId}'s
    // write:false precedent; the admin routes write through the admin SDK,
    // which bypasses these rules entirely.
    match /job_board_companies/{companyId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
