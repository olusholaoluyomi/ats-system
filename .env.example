# -----------------------------------------------------------------------------
# LLM providers
# at least one provider must be configured for /api/analyze to work.
# the chain is composed in this order, falling through on failure:
#   1. Ollama (local, optional)
#   2. Gemini 3.5 Flash Lite via Google
#   3. Claude Haiku 4.5 via Anthropic (cross-vendor fallback, opt-in - no free tier)
#   4. GPT-OSS 120B via Groq (cross-vendor fallback, free tier)
# one model per vendor on purpose: a second model on the same key shares that key's
# quota, so it adds latency without adding redundancy.
# -----------------------------------------------------------------------------

# Google Gemini API key (primary cloud LLM provider)
# get yours at https://aistudio.google.com/apikey
# your per-project limits live at https://aistudio.google.com/usage
GEMINI_API_KEY=

# Claude (Anthropic) API key (optional cloud fallback, Haiku 4.5)
# get yours at https://console.anthropic.com/settings/keys
# NOTE: unlike every other provider here, Anthropic has no free tier - every
# fallback call that reaches this leg is billed to your account. leave this unset
# to run on Gemini + Groq only at no cost; set it if you want a paid fallback
# that isn't subject to Groq's free-tier rate limits.
# CLAUDE_API_KEY=

# Groq API key (cloud fallback, GPT-OSS 120B, free tier)
# get yours at https://console.groq.com/keys
# GROQ_API_KEY=

# Ollama (optional, self-hosters only)
# when OLLAMA_BASE_URL is set, the local Ollama daemon prepends to the provider
# chain so a fork running purely on local models needs no cloud keys.
# OLLAMA_MODEL is any tag from `ollama list` and defaults to llama3.2.
# leave all three unset to keep the cloud-only chain (Gemma, Groq) used in prod.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# OLLAMA_API_KEY (optional). only needed when your Ollama daemon sits behind a
# reverse proxy that requires a bearer token, or when you point OLLAMA_BASE_URL
# at a hosted Ollama-compatible endpoint (OpenWebUI, LiteLLM, OpenRouter, a
# Cloudflare-tunneled daemon with a service token, etc.). when set, every
# request includes `Authorization: Bearer <key>`. vanilla local `ollama serve`
# has no auth and leaves this unset.
# OLLAMA_API_KEY=

# -----------------------------------------------------------------------------
# Firebase (optional on self-host, required on hosted)
# -----------------------------------------------------------------------------
# the hosted instance at ats-screener.olusholaoluyomi.com uses Firebase for sign-in
# (Google + email) and for cross-device scan history via Firestore. set every
# PUBLIC_FIREBASE_* var below to enable that mode.
#
# self-host without Firebase: leave EVERY PUBLIC_FIREBASE_* var unset and the
# app detects it at startup (single signal: a non-empty PUBLIC_FIREBASE_PROJECT_ID).
# in that mode the scanner unlocks for anonymous local use, scan history
# persists to the browser's localStorage (capped at 5 newest-first), the Sign
# In button and user menu are hidden, /login redirects to /scanner, and the
# Firebase SDK is never even imported. see /docs/self-hosting/configuration
# for the full trade-offs.
#
# get these from Firebase Console → Project Settings → Your Apps:
# PUBLIC_FIREBASE_API_KEY=
# PUBLIC_FIREBASE_AUTH_DOMAIN=
# PUBLIC_FIREBASE_PROJECT_ID=
# PUBLIC_FIREBASE_STORAGE_BUCKET=
# PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# PUBLIC_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# Authentication (optional self-host: Active Directory / LDAP)
# -----------------------------------------------------------------------------
# for self-hosters running INSIDE their own network (a domain-joined Windows
# Server or a LAN host that can reach a domain controller). when LDAP_URL is set
# the app switches to AD sign-in: users log in with their AD username + password,
# the scanner sits behind that login, and history is kept per user in the browser.
#
# mode precedence: LDAP (LDAP_URL set) > Firebase (PUBLIC_FIREBASE_PROJECT_ID set)
# > anonymous (neither). leave LDAP_URL unset and none of this applies. the
# hosted instance never sets these. full guide: /docs/self-hosting/active-directory
#
# required when LDAP_URL is set:
# LDAP_URL=ldaps://dc.corp.example.com:636
# LDAP_BIND_DN=CN=svc-ats,OU=Service Accounts,DC=corp,DC=example,DC=com
# LDAP_BIND_PASSWORD=
# LDAP_SEARCH_BASE=DC=corp,DC=example,DC=com
# SESSION_SECRET= # 32+ random chars, e.g. openssl rand -base64 32
#
# optional:
# LDAP_USERNAME_ATTRIBUTES=sAMAccountName,userPrincipalName
# LDAP_DEFAULT_DOMAIN=corp.example.com   # lets a bare "jdoe" resolve as a UPN
# LDAP_ALLOWED_GROUP_DN=CN=ATS Users,OU=Groups,DC=corp,DC=example,DC=com
# LDAP_NAME_ATTRIBUTE=displayName
# LDAP_EMAIL_ATTRIBUTE=mail
# LDAP_TLS_CA_PATH=/etc/ssl/certs/corp-internal-ca.pem  # for LDAPS w/ internal CA
# LDAP_TLS_REJECT_UNAUTHORIZED=true   # set false only in a throwaway lab
# SESSION_MAX_AGE=28800   # session lifetime in seconds (default 8h)

# -----------------------------------------------------------------------------
# Paystack payments (optional, hosted paid-review model)
# -----------------------------------------------------------------------------
# enables the pay-per-review model used by the hosted instance: the first
# full-score review per Firebase account is FREE, every subsequent review costs
# the configured price. users pay on Paystack's hosted checkout page; the
# /api/payment/webhook endpoint settles the charge and /api/payment/verify
# confirms it after the redirect. only meaningful when Firebase mode is active
# (PUBLIC_FIREBASE_PROJECT_ID set); ldap/none modes have no wallet concept
# and stay inert.
#
# get a secret key at https://dashboard.paystack.com → Settings → API Keys &
# Webhooks. also add your site as a webhook endpoint there for
# `https://<your-domain>/api/payment/webhook` (event: charge.success).
#
# Currency configuration (supports NGN, USD, GHS, KES, ZAR):
# PAYSTACK_SECRET_KEY=
# PAYSTACK_CURRENCY=NGN
# PAYSTACK_PRICE_NGN=10000
# PAYSTACK_PRICE_USD=10
# PAYSTACK_PRICE_GHS=100
# PAYSTACK_PRICE_KES=1000
# PAYSTACK_PRICE_ZAR=200

# -----------------------------------------------------------------------------
# Operations (optional, defaults are sane)
# -----------------------------------------------------------------------------

# admin token for /api/admin/rate-limit-stats. must be 16+ chars. endpoint
# returns 503 when unset (fail-closed). generate one with: openssl rand -hex 32
# ADMIN_TOKEN=

# deterministic sample rate for scan_logs writes. default 1.0 (log every scan).
# at high traffic, set lower (e.g. 0.1 = 10% of scans) to stay inside the
# Firestore Spark write quota. only meaningful when Firebase is configured.
# PUBLIC_SCAN_LOG_SAMPLE_RATE=1.0

# client error reporter (window.onerror, unhandledrejection) sample rate.
# default 0.05 (5% of clients report). lower for high-traffic, raise for
# debugging. never set to 0 in production unless you also want no signal.
# PUBLIC_ERROR_SAMPLE_RATE=0.05

# web vitals (LCP, CLS) reporter sample rate. default 0.05.
# PUBLIC_VITALS_SAMPLE_RATE=0.05
