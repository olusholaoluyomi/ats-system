# Exclude build cache directories
.vercel
dist
.svelte-kit
build
.next
.cache

# Exclude dependency directories (Vercel handles these)
node_modules
.pnpm-store

# Exclude test coverage
coverage

# Exclude environment files (these should be in Vercel env vars)
.env
.env.local
.env.*.local

# Exclude IDE files
.vscode
.idea
*.swp
*.swo
*~

# Exclude OS files
.DS_Store
Thumbs.db

# Exclude logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Exclude temporary files
*.tmp
.temp
